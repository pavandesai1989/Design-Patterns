We have XML data coming from a legacy system. Our analytics tool the data in json format. 
Since XMLData does not implement that interface, we create XMLToJSONAdapter.
The adapter implements datatool and internally uses XMLData to convert XML into JSON. 
The client only knows the datatool abstraction and remains unchanged.
/*
=========================================================
ADAPTER DESIGN PATTERN - XML DATA TO ANALYTICS TOOL
=========================================================

Problem:
--------
We have XML data coming from an existing legacy system.
But our Data Analytics Tool accepts only JSON data.

We cannot modify:
1. Existing XMLData class (legacy/third-party code)
2. Data Analytics Tool

So we need an Adapter.
Adapter will:
1. Take XML data
2. Convert it into JSON format
3. Pass JSON to Analytics Tool


#include<iostream>
#include<string>

using namespace std;


/*
=========================================================
ADAPTEE (Legacy Class)
=========================================================

Existing system provides XML data.

We cannot modify this class.
*/

class XMLData
{
private:

    string xmldata;


public:

    XMLData(string data)
        : xmldata(data)
    {
    }


    string getXMLData()
    {
        return xmldata;
    }
};



/*
=========================================================
TARGET INTERFACE
=========================================================

Analytics tool expects JSON data.

Client works with this interface.
*/

class DataAnalyticsTool
{
public:

    virtual void analyseData(string jsonData) = 0;


    virtual ~DataAnalyticsTool() = default;
};



/*
=========================================================
ADAPTER
=========================================================

Adapter converts:

XMLData  --->  JSON

It implements the interface expected by client.

Relationship:

Adapter IS-A DataAnalyticsTool

Adapter HAS-A XMLData

=========================================================
*/

class XMLToJSONAdapter : public DataAnalyticsTool
{
private:

    XMLData* xmlData;


public:

    XMLToJSONAdapter(XMLData* data)
        : xmlData(data)
    {
    }


    void analyseData(string dummy) override
    {
        /*
        Step 1:
        Get XML from legacy system
        */

        string xml = xmlData->getXMLData();


        cout<<"Received XML: "
            <<xml<<endl;


        /*
        Step 2:
        Convert XML to JSON

        Real project:
        Use XML parser/converter library.

        Here we simulate conversion.
        */

        string json = "{name:John}";


        /*
        Step 3:
        Send JSON to analytics logic
        */

        cout<<"Analysing JSON: "
            <<json<<endl;
    }
};



/*
=========================================================
CLIENT
=========================================================

Client only knows DataAnalyticsTool.

It does not know XMLData.

=========================================================
*/

class Client
{
public:

    void processData(DataAnalyticsTool* tool)
    {
        tool->analyseData("");
    }
};



int main()
{

    XMLData xml("<name>John</name>");


    /*
    Adapter wraps XMLData
    */

    XMLToJSONAdapter adapter(&xml);


    Client client;


    /*
    Client thinks it is calling
    a normal Analytics Tool.

    Internally Adapter converts XML -> JSON.
    */

    client.processData(&adapter);


    return 0;
}

