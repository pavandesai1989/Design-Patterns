# WITH DECORATOR

Instead of creating subclasses for every combination,
we create **one decorator per feature**.

Decorators are chained dynamically.

---

## WITH DECORATOR CODE

```cpp
#include<iostream>
using namespace std;

// Component
class Pizza
{
public:
    virtual string getDescription() = 0;
    virtual int getCost() = 0;
    virtual ~Pizza() = default;
};

// Concrete Component
class PlainPizza : public Pizza
{
public:
    string getDescription() override
    {
        return "Plain Pizza";
    }

    int getCost() override
    {
        return 100;
    }
};

// Abstract Decorator
class PizzaDecorator : public Pizza
{
protected:
    Pizza* p;

public:
    PizzaDecorator(Pizza* ptr)
        : p(ptr)
    {
    }

    virtual ~PizzaDecorator()
    {
        delete p;
    }

    virtual string getDescription() = 0;
    virtual int getCost() = 0;
};

// Concrete Decorator
class Cheese : public PizzaDecorator
{
public:
    Cheese(Pizza* p)
        : PizzaDecorator(p)
    {
    }

    string getDescription() override
    {
        return p->getDescription() + " Cheese";
    }

    int getCost() override
    {
        return p->getCost() + 50;
    }
};

// Concrete Decorator
class Olives : public PizzaDecorator
{
public:
    Olives(Pizza* p)
        : PizzaDecorator(p)
    {
    }

    string getDescription() override
    {
        return p->getDescription() + " Olives";
    }

    int getCost() override
    {
        return p->getCost() + 80;
    }
};

int main()
{
    Pizza* p = new PlainPizza();

    p = new Cheese(p);

    p = new Olives(p);

    cout << p->getDescription() << endl;
    cout << p->getCost() << endl;

    delete p;
}
```
