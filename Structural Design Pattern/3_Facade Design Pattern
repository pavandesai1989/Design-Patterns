10. WITHOUT FACADE
=========================================================


Client manages all subsystem calls.


Architecture:

Client

 |
 |---- PaymentGateway
 |
 |---- Inventory
 |
 |---- InvoiceSystem
 |
 |---- EmailService



Code:


#include<iostream>
using namespace std;


class PaymentGateway
{
public:

    void processPayment()
    {
        cout<<"Payment processed\n";
    }
};


class Inventory
{
public:

    void checkStock()
    {
        cout<<"Inventory checked\n";
    }
};


class InvoiceSystem
{
public:

    void generateInvoice()
    {
        cout<<"Invoice generated\n";
    }
};


class EmailService
{
public:

    void sendEmail()
    {
        cout<<"Email sent\n";
    }
};


int main()
{
    PaymentGateway payment;
    Inventory inventory;
    InvoiceSystem invoice;
    EmailService email;


    inventory.checkStock();

    payment.processPayment();

    invoice.generateInvoice();

    email.sendEmail();


    cout<<"Order completed\n";

    return 0;
}



Problem:

Client knows:

- All subsystem classes
- Execution order
- Internal workflow



