#include <iostream>
using namespace std;

// Base Class
class Beverage
{
public:
    // Template Method (fixed workflow)
    void prepareDrink()
    {
        boilWater();
        addIngredients();   // Variable step
        pourIntoCup();
        addSugar();
    }

    virtual ~Beverage() = default;

protected:
    void boilWater()
    {
        cout << "Boiling Water\n";
    }

    virtual void addIngredients() = 0;

    void pourIntoCup()
    {
        cout << "Pouring into Cup\n";
    }

    void addSugar()
    {
        cout << "Adding Sugar\n";
    }
};

// Concrete Class
class Tea : public Beverage
{
protected:
    void addIngredients() override
    {
        cout << "Adding Tea Leaves\n";
    }
};

// Concrete Class
class Coffee : public Beverage
{
protected:
    void addIngredients() override
    {
        cout << "Adding Coffee Powder\n";
    }
};

int main()
{
    Tea tea;
    Coffee coffee;

    cout << "Preparing Tea\n";
    tea.prepareDrink();

    cout << "\nPreparing Coffee\n";
    coffee.prepareDrink();

    return 0;
}
